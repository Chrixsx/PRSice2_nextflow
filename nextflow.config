// ---------------------------------------------------------------------------
// Nextflow config for WEHI HPC (SLURM)
// ---------------------------------------------------------------------------

// Keep intermediate work files; delete with: nextflow clean -f
workDir = "/vast/scratch/users/le.c/nextflow_work/prsice2"

process {
    executor      = 'slurm'
    time          = '1h'
    cpus          = 1
    memory        = '6 GB'
    // errorStrategy: finish lets other traits complete before the pipeline exits
    errorStrategy = 'finish'

    withName: 'REFORMAT_GWAS' {
        time   = '10min'
        memory = '5 GB'   // vroom reads the full file into memory
        clusterOptions = '--mail-type=FAIL --mail-user=le.c@wehi.edu.au'
    }

    withName: 'RUN_PRSICE' {
        clusterOptions = '--mail-type=FAIL,END --mail-user=le.c@wehi.edu.au'
    }
}

executor {
    name            = 'slurm'
    queueSize       = 200   // max concurrent SLURM jobs; Nextflow queues the rest
    submitRateLimit = '20/1min'
}

// Produce a timeline and resource report in the output directory
timeline {
    enabled = true
    file    = "/vast/projects/Epilepsy_Metabolites/scripts/PRSice2/prs_metab_GSA_Dec2025/2.output/_nextflow_reports/timeline.html"
}

report {
    enabled = true
    file    = "/vast/projects/Epilepsy_Metabolites/scripts/PRSice2/prs_metab_GSA_Dec2025/2.output/_nextflow_reports/report.html"
}

// Resume caching: Nextflow skips traits whose work dir already has valid outputs
// Use `nextflow run main.nf -resume` to restart after a partial run
